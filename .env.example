# Copy this file to .env for local work. Do not commit .env.

# Product strings. The pages, the MCP server info, and the notifications use them.
APP_NAME=MCP Client
SUPPORT_EMAIL=support@example.com
PUBLIC_BASE_URL=http://localhost:8000
APP_STORE_URL=

# Key Value store (Valkey or Redis). One node, no cluster.
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=mc
REDIS_MAX_CONNECTIONS=20

# Apple Push Notification service, token authentication. If these are empty, push is off.
# Give the .p8 key as text (APNS_KEY_P8, "\n" is accepted for a new line) or as a file path (APNS_KEY_PATH).
APNS_KEY_P8=
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_WATCH_BUNDLE_ID=

# App integrity. Each check is off if its value is empty. See docs/app-integrity.md.
# App Attest: the app IDs (TEAMID.bundle.identifier) with commas between them, and "production" or "development".
APP_ATTEST_APP_IDS=
APP_ATTEST_ENVIRONMENT=production
# App code: a base32 secret that the app also has. The app sends a one-time code from it with each request.
APP_TOTP_SECRET=

# Rate limits. 0 turns a limit off.
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_ACCOUNTS_PER_HOUR=20

# Browser origins that can call /mcp, with commas between them. The origin of PUBLIC_BASE_URL is always allowed.
MCP_ALLOWED_ORIGINS=

# Process
HOST=0.0.0.0
PORT=8000
WEB_CONCURRENCY=1
LOG_LEVEL=INFO
